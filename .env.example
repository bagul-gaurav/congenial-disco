# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studio?schema=public"

# Server-side only. Used by /api/spec to turn a plain-language component
# description into a props + states proposal. Never exposed to the browser.
OPENROUTER_API_KEY="sk-or-v1-..."

# Any OpenRouter model slug that supports structured outputs (json_schema).
# Override to switch models without touching code.
OPENROUTER_MODEL="anthropic/claude-sonnet-4.5"

# Optional. OpenRouter shows these on its dashboard for attribution.
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_SITE_NAME="Studio"
