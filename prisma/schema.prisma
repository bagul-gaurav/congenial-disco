generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A User row exists from day one even though the vertical slice has no login.
// Adding Auth.js later is then a wiring change rather than a migration.
model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  createdAt DateTime  @default(now())
  projects  Project[]
}

model Project {
  id         String      @id @default(cuid())
  name       String
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  components Component[]

  @@index([userId])
}

model Component {
  id        String   @id @default(cuid())
  name      String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // The serialized ComponentDoc (see src/model/types.ts). Kept as JSON so the
  // document model can evolve without a migration per shape change; `docVersion`
  // lets loaders migrate older documents forward.
  doc        Json
  docVersion Int      @default(1)
  // Bumped on every write. A save carries the revision it was based on, so a
  // second tab holding a stale document is refused rather than silently
  // overwriting the newer one.
  revision   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Unguessable token for read-only sharing. Null means not shared; revoking
  // clears it, so an old link stops working immediately.
  shareToken String?  @unique

  versions ComponentVersion[]

  @@index([projectId])
}

// A point-in-time snapshot of a component's document.
//
// Snapshots are throttled rather than written on every autosave: a session of
// dragging a slider should leave one entry in the history, not two hundred.
model ComponentVersion {
  id          String    @id @default(cuid())
  componentId String
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  doc         Json
  // What the component was called when this snapshot was taken, so the history
  // still reads correctly after a rename.
  name        String
  // Set when a user explicitly saved this point, rather than it being an
  // automatic snapshot.
  label       String?
  createdAt   DateTime  @default(now())

  @@index([componentId, createdAt])
}
